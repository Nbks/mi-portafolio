---
import Layout from '../../layouts/Layout.astro';
import { locales, getLangFromParams, useTranslations } from '../../i18n/utils';
import { experience } from '../../data/experience';
import { skills } from '../../data/skills';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromParams(Astro.params);
const t = useTranslations(lang);
---

<Layout {lang} title={`Lucas Giavelli — ${t.nav_about}`} description={t.hero_bio} currentPage="about" {t}>

  <!-- PAGE HEADER -->
  <header class="py-8 pb-16 border-b border-border animate-fade-up">
    <p class="font-mono text-xs text-accent tracking-widest uppercase mb-6">Lucas Giavelli</p>
    <h1 class="font-display text-[clamp(3rem,8vw,5.5rem)] font-black leading-[0.95] tracking-tighter">
      {t.about_title_p1}<br /><em class="italic text-accent">{t.about_title_p2}</em>
    </h1>
  </header>

  <!-- BIO -->
  <section class="py-16 border-b border-border animate-fade-up last:border-none">
    <h2 class="font-display text-[2rem] font-black tracking-tighter mb-10">{t.about_bio}</h2>
    <div class="text-base text-[#a0a0a0] leading-relaxed max-w-[600px] space-y-5">
      <p>{t.bio_p1}</p>
      <p>{t.bio_p2}</p>
      <p>{t.bio_p3}</p>
      <p>{t.bio_p4}</p>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="py-16 border-b border-border animate-fade-up last:border-none">
    <h2 class="font-display text-[2rem] font-black tracking-tighter mb-10">{t.about_experience}</h2>
    <ul class="list-none p-0 m-0">
      {experience.map((job) => (
        <li class="grid grid-cols-[1fr_auto] gap-4 py-8 border-t border-border items-start max-sm:grid-cols-1">
          <div>
            <h3 class="font-display text-xl font-bold mb-1">{job.company}</h3>
            <p class="font-mono text-sm text-accent tracking-wide mb-3">{job.role[lang]}</p>
            <p class="text-sm text-[#888] leading-relaxed max-w-[480px]">{job.description[lang]}</p>
          </div>
          <span class="font-mono text-xs text-gray whitespace-nowrap">{job.period}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- SKILLS -->
  <section class="py-16 border-b border-border animate-fade-up last:border-none">
    <h2 class="font-display text-[2rem] font-black tracking-tighter mb-10">{t.about_skills}</h2>
    <div class="grid grid-cols-2 gap-10 max-sm:grid-cols-1">
      {skills[lang].map((group) => (
        <div>
          <p class="font-mono text-xs text-accent tracking-wider uppercase mb-4">{group.category}</p>
          <div class="flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <span class="font-mono text-sm text-white border border-border px-3 py-1 tracking-wide transition-colors duration-200 hover:border-accent hover:text-accent">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- INTERESTS -->
  <section class="py-16 border-b border-border animate-fade-up last:border-none">
    <h2 class="font-display text-[2rem] font-black tracking-tighter mb-10">{t.about_interests}</h2>
    <div class="text-base text-[#a0a0a0] leading-relaxed max-w-[600px]">
      <p>{t.interests_p1}</p>
    </div>
  </section>

</Layout>
