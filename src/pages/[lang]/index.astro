---
import Layout from '../../layouts/Layout.astro';
import { locales, getLangFromParams, useTranslations } from '../../i18n/utils';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = getLangFromParams(Astro.params);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout {lang} title="Lucas Giavelli — Full-stack Developer" description={t.hero_bio} currentPage="home" {t}>

  <!-- HERO -->
  <section class="py-8 pb-16 border-b border-border animate-fade-up">
    <p class="font-mono text-xs text-accent tracking-widest uppercase mb-6">{t.hero_eyebrow}</p>
    <h1 class="font-display text-[clamp(3rem,8vw,5.5rem)] font-black leading-[0.95] tracking-tighter mb-1">
      Lucas<br /><em class="italic text-accent">Giavelli</em>
    </h1>
    <p class="font-display text-[clamp(1.2rem,3vw,1.7rem)] font-bold italic text-gray mb-8 leading-tight">{t.hero_tagline}</p>
    <p class="text-base text-[#a0a0a0] max-w-[480px] leading-relaxed mb-10">{t.hero_bio}</p>
    <div class="flex flex-wrap gap-3">
      <a href="https://github.com/Nbks" class="font-mono text-xs text-white no-underline tracking-wide px-4 py-2 border transition-colors duration-200 hover:border-accent hover:text-accent bg-accent border-accent" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/lucas-giavelli-0b03821aa" class="font-mono text-xs text-white no-underline tracking-wide px-4 py-2 border border-border transition-colors duration-200 hover:border-accent hover:text-accent" target="_blank" rel="noopener">LinkedIn</a>
      <a href="mailto:lucasgiavelli98@gmail.com" class="font-mono text-xs text-white no-underline tracking-wide px-4 py-2 border border-border transition-colors duration-200 hover:border-accent hover:text-accent">{t.nav_contact}</a>
      <a href={`${base}/cv.pdf`} class="font-mono text-xs text-white no-underline tracking-wide px-4 py-2 border border-border transition-colors duration-200 hover:border-accent hover:text-accent" target="_blank">CV</a>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="py-16 animate-fade-up-delay" id="projects">
    <div class="flex items-baseline gap-4 mb-12">
      <h2 class="font-display text-[2rem] font-black tracking-tighter">{t.projects_title}</h2>
      <span class="font-mono text-xs text-accent">({projects.length})</span>
    </div>
    <ul class="list-none p-0">
      {projects.map((project) => (
        <li class="group grid grid-cols-[1fr_auto] gap-4 items-start border-t border-border py-8 -mx-8 px-8 hover:bg-[#111] transition-colors duration-200 max-sm:grid-cols-1">
          <div>
            <h3 class="font-display text-xl font-bold mb-1 group-hover:text-accent transition-colors duration-200">
              <a href={project.url} target="_blank" rel="noopener" class="text-inherit no-underline">{project.title}</a>
            </h3>
            <p class="text-sm text-[#888] leading-relaxed mb-3 max-w-[520px]">{project.description[lang]}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="font-mono text-[0.7rem] text-gray border border-border px-2 py-0.5 tracking-wide">{tag}</span>
              ))}
            </div>
          </div>
          <div class="text-right flex flex-col gap-2 items-end max-sm:flex-row max-sm:items-center max-sm:text-left">
            <span class="font-mono text-xs text-gray whitespace-nowrap">{project.year}</span>
            <div class="flex gap-2">
              <a href={project.url} class="font-mono text-[0.7rem] text-gray no-underline tracking-wide transition-colors duration-200 hover:text-accent" target="_blank" rel="noopener">{t.project_repo} ↗</a>
              {project.demo && (
                <a href={project.demo} class="font-mono text-[0.7rem] text-gray no-underline tracking-wide transition-colors duration-200 hover:text-accent" target="_blank" rel="noopener">{t.project_demo} ↗</a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

</Layout>
