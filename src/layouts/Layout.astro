---
// src/layouts/Layout.astro
import type { Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  currentPage?: 'home' | 'about';
  t: Record<string, string>;
}

const { lang, title, description, currentPage = 'home', t } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="icon" href="/src/assets/favicon.svg">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

  <style>
    /* ─── RESET ─── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ─── VARIABLES ─── */
    :root {
      --black: #0a0a0a;
      --white: #f5f2eb;
      --accent: #c8371a;
      --gray: #6b6b6b;
      --border: #2a2a2a;
      --font-display: 'Playfair Display', serif;
      --font-mono: 'DM Mono', monospace;
      --font-body: 'DM Sans', sans-serif;
    }

    /* ─── BASE ─── */
    html {
      background-color: var(--black);
      color: var(--white);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ─── LAYOUT ─── */
    .container {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* ─── NAV ─── */
    nav {
      padding: 2rem 0;
      border-bottom: 1px solid var(--border);
    }

    .nav-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .nav-logo {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--accent);
      text-decoration: none;
      letter-spacing: 0.05em;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }

    .nav-links a {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--gray);
      text-decoration: none;
      letter-spacing: 0.05em;
      transition: color 0.2s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--white);
    }

    /* ─── LANG SELECTOR ─── */
    .lang-selector {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
    }

    .lang-selector a {
      color: var(--gray);
      text-decoration: none;
      letter-spacing: 0.05em;
      transition: color 0.2s;
    }

    .lang-selector a:hover { color: var(--white); }
    .lang-selector a.active { color: var(--accent); pointer-events: none; }
    .lang-divider { color: var(--border); user-select: none; }

    /* ─── FOOTER ─── */
    footer {
      border-top: 1px solid var(--border);
      padding: 2rem 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .footer-copy {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--gray);
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
    }

    .footer-links a {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--gray);
      text-decoration: none;
      transition: color 0.2s;
    }

    .footer-links a:hover { color: var(--white); }

    /* ─── SHARED SECTION STYLES ─── */
    .section-header {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 900;
      letter-spacing: -0.02em;
    }

    .section-count {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent);
    }

    .tag {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--gray);
      border: 1px solid var(--border);
      padding: 0.15rem 0.5rem;
      letter-spacing: 0.03em;
    }

    /* ─── ANIMATIONS ─── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 600px) {
      .nav-links { display: none; }
      footer { flex-direction: column; gap: 1rem; text-align: center; }
    }
  </style>

  <!-- Slot para estilos específicos de cada página -->
  <slot name="head" />
</head>
<body>

  <!-- NAV -->
  <div class="container">
    <nav>
      <div class="nav-inner">
        <a href={`/${lang}`} class="nav-logo">LG.dev</a>
        <div class="nav-right">
          <ul class="nav-links">
            <li><a href={`/${lang}`} class={currentPage === 'home' ? 'active' : ''}>{t.nav_projects}</a></li>
            <li><a href={`/${lang}/about`} class={currentPage === 'about' ? 'active' : ''}>{t.nav_about}</a></li>
            <li><a href="mailto:tu@email.com">{t.nav_contact}</a></li>
          </ul>
          <div class="lang-selector">
            <a href={`/es/${currentPage === 'about' ? 'about' : ''}`} class={lang === 'es' ? 'active' : ''}>es</a>
            <span class="lang-divider">|</span>
            <a href={`/en/${currentPage === 'about' ? 'about' : ''}`} class={lang === 'en' ? 'active' : ''}>en</a>
            <span class="lang-divider">|</span>
            <a href={`/it/${currentPage === 'about' ? 'about' : ''}`} class={lang === 'it' ? 'active' : ''}>it</a>
          </div>
        </div>
      </div>
    </nav>
  </div>

  <!-- CONTENIDO DE CADA PÁGINA -->
  <main class="container">
    <slot />
  </main>

  <!-- FOOTER -->
  <div class="container">
    <footer>
      <span class="footer-copy">© 2026 Lucas Giavelli</span>
      <div class="footer-links">
        <a href="https://github.com/Nbks" target="_blank" rel="noopener">GitHub</a>
        <a href="https://linkedin.com/in/tu-perfil" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:tu@email.com">Email</a>
      </div>
    </footer>
  </div>

</body>
</html>