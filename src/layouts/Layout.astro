---
import type { Locale } from '../i18n/utils';
import '../styles/global.css';
import favicon from '../assets/favicon.svg';
import profileImg from '../assets/profile.jpeg';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  image?: string;
  currentPage?: 'home' | 'about';
  t: Record<string, string>;
}

const { lang, title, description, image, currentPage = 'home', t } = Astro.props;

const siteUrl = 'https://lucasgiavelli.site';
const pageUrl = `${siteUrl}/${lang}${currentPage === 'about' ? '/about' : ''}`;
const ogImage = image
  ? image.startsWith('http')
    ? image
    : new URL(image, Astro.site).toString()
  : new URL(profileImg.src, Astro.site).toString();
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={pageUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang} />
  <meta property="og:site_name" content="NBKS Portfolio" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="icon" href={favicon.src} />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body class="bg-black text-white font-body antialiased">
  <div class="max-w-[760px] mx-auto px-8">
    <nav class="py-8 border-b border-border">
      <div class="flex justify-between items-center gap-4">
        <a href={`/${lang}`} class="font-mono text-sm text-accent no-underline tracking-wide">LG.dev</a>
        <div class="flex items-center gap-8 max-sm:gap-3">
          <ul class="flex gap-8 list-none max-sm:hidden">
            <li>
              <a href={`/${lang}`} class={`font-mono text-sm no-underline tracking-wide transition-colors duration-200 ${currentPage === 'home' ? 'text-white' : 'text-gray hover:text-white'}`}>{t.nav_projects}</a>
            </li>
            <li>
              <a href={`/${lang}/about`} class={`font-mono text-sm no-underline tracking-wide transition-colors duration-200 ${currentPage === 'about' ? 'text-white' : 'text-gray hover:text-white'}`}>{t.nav_about}</a>
            </li>
            <li>
              <a href="mailto:lucasgiavelli98@gmail.com" class="font-mono text-sm text-gray no-underline tracking-wide transition-colors duration-200 hover:text-white">{t.nav_contact}</a>
            </li>
          </ul>
          <div class="flex items-center gap-2 font-mono text-xs">
            <a href={`/es${currentPage === 'about' ? '/about' : ''}`} class={`no-underline tracking-wide transition-colors duration-200 ${lang === 'es' ? 'text-accent pointer-events-none' : 'text-gray hover:text-white'}`}>es</a>
            <span class="text-border select-none">|</span>
            <a href={`/en${currentPage === 'about' ? '/about' : ''}`} class={`no-underline tracking-wide transition-colors duration-200 ${lang === 'en' ? 'text-accent pointer-events-none' : 'text-gray hover:text-white'}`}>en</a>
            <span class="text-border select-none">|</span>
            <a href={`/it${currentPage === 'about' ? '/about' : ''}`} class={`no-underline tracking-wide transition-colors duration-200 ${lang === 'it' ? 'text-accent pointer-events-none' : 'text-gray hover:text-white'}`}>it</a>
          </div>
          <button id="menu-btn" class="sm:hidden font-mono text-sm text-gray hover:text-white cursor-pointer bg-transparent border-none p-1 leading-none" aria-label="Menu">
            <span id="menu-icon">☰</span>
          </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden sm:hidden pt-6 pb-2">
        <ul class="flex flex-col gap-5 list-none">
          <li>
            <a href={`/${lang}`} class={`font-mono text-sm no-underline tracking-wide transition-colors duration-200 ${currentPage === 'home' ? 'text-white' : 'text-gray hover:text-white'}`}>{t.nav_projects}</a>
          </li>
          <li>
            <a href={`/${lang}/about`} class={`font-mono text-sm no-underline tracking-wide transition-colors duration-200 ${currentPage === 'about' ? 'text-white' : 'text-gray hover:text-white'}`}>{t.nav_about}</a>
          </li>
          <li>
            <a href="mailto:lucasgiavelli98@gmail.com" class="font-mono text-sm text-gray no-underline tracking-wide transition-colors duration-200 hover:text-white">{t.nav_contact}</a>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <main class="max-w-[760px] mx-auto px-8">
    <slot />
  </main>

  <div class="max-w-[760px] mx-auto px-8">
    <footer class="border-t border-border py-8 flex justify-between items-center max-sm:flex-col max-sm:gap-4 max-sm:text-center">
      <span class="font-mono text-xs text-gray">© 2026 Lucas Giavelli</span>
      <div class="flex gap-6">
        <a href="https://github.com/Nbks" target="_blank" rel="noopener" class="font-mono text-xs text-gray no-underline transition-colors duration-200 hover:text-white">GitHub</a>
        <a href="https://linkedin.com/in/tu-perfil" target="_blank" rel="noopener" class="font-mono text-xs text-gray no-underline transition-colors duration-200 hover:text-white">LinkedIn</a>
        <a href="mailto:lucasgiavelli98@gmail.com" class="font-mono text-xs text-gray no-underline transition-colors duration-200 hover:text-white">Email</a>
      </div>
    </footer>
  </div>
  <script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const icon = document.getElementById('menu-icon');
    if (btn && menu && icon) {
      btn.addEventListener('click', () => {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        icon.textContent = isOpen ? '☰' : '✕';
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    }
  </script>
</body>
</html>
